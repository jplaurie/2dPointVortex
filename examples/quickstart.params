# Run from the repository root; output directories are created automatically.
# Two opposite-sign vortices on the built-in unit-radius ring.
N 2
initialCondition ring
boundaryCondition infinite
coreRadius 0
integrator rk4
timeStep 0.001
endTime 0.1
outputTime 0.02
numThreads 1
dipoleRemoval false
runDirectory runs/quickstart
overwriteRun false
